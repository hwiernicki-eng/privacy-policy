# Copier à la racine du dépôt en .env. Toutes les variables sont validées au démarrage (src/server/config.ts).

NODE_ENV=production
PORT=3000
# URL publique exacte (schéma + domaine, sans slash final) : sert au contrôle Origin et aux liens des emails
APP_URL=https://carnet.example.fr
# Proxy de confiance pour X-Forwarded-For : IP(s) du reverse proxy (option A : IP Tailscale du VPS ;
# option B : 127.0.0.1). "false" si aucun proxy. Éviter "true" (fait confiance à n'importe quel client).
TRUST_PROXY=100.64.0.1
# Adresse d'écoute publiée par Docker (127.0.0.1, ou IP Tailscale/LAN du CT en option A)
APP_BIND=127.0.0.1
TZ=Europe/Paris
DATA_DIR=/data

# Comptes
REGISTRATION_OPEN=false
SESSION_TTL_DAYS=30

# Clé de chiffrement des secrets de canaux (32 octets en base64) : openssl rand -base64 32
# À sauvegarder hors de la base : la perdre oblige à recréer les canaux de notification.
SECRETS_KEY=

# Tick du job de notifications (fuseau TZ) ou "off". L'heure d'envoi est choisie par chaque utilisateur.
REMINDER_CRON=*/15 * * * *

# Web Push (notifications téléphone) : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.fr

# ntfy : serveurs autorisés (origines https, séparées par des virgules)
NTFY_ALLOWED_SERVERS=https://ntfy.sh

# SMTP
SMTP_HOST=smtp.example.fr
SMTP_PORT=587
# true pour le port 465 (TLS implicite), false pour STARTTLS sur 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Carnet d'entretien <carnet@example.fr>"

LOG_LEVEL=info
